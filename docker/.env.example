# Docker environment variables
# Copy this file to .env and adjust the values for your setup:
#   cp .env.example .env

# Your system username (used to create matching user inside the container)
USERNAME=user

# Path to your local ivS-Graphs workspace (mounted into the container)
VS_GRAPHS_WS=../

# Path to your datasets directory (e.g., ROS bags)
DATASETS_DIR=~/datasets
